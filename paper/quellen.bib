	editorbtype = {redactor},
	urldate = {2026-05-05},
	date = {2006},
	langid = {english},
	note = {Series Title: Lecture Notes in Computer Science},
	file = {PDF:/home/hrd/Zotero/storage/EZTV9DUB/Osvik et al. - 2006 - Cache Attacks and Countermeasures The Case of AES.pdf:application/pdf},
}

